// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/* ------------------------------------------------------------------------- */
/*  USERS & SUBSCRIPTIONS (you already had)                                  */
/* ------------------------------------------------------------------------- */

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  username         String?          @unique
  hashedPassword   String?
  stripeCustomerId String?          @unique
  tempNotes        String?
  roseWasHere      String?

  /* relations */
  subscriptions    Subscription[]
  resourceAccess   ResourceAccess[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])

  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stripeSubscriptionId, updatedAt])
}

/* ------------------------------------------------------------------------- */
/*  NEW:  ONE-OFF ENTITLEMENTS & IDEMPOTENCY LOG                              */
/* ------------------------------------------------------------------------- */

model ResourceAccess {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id])

  resourceId               String
  grantedByPaymentIntentId String
  revokedAt                DateTime?
  revokeReason             String?
  revokedByStripeObjectId  String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([userId, resourceId])
  @@index([grantedByPaymentIntentId])
}

model StripeEventLog {
  id         String   @id @default(cuid())
  eventId    String   @unique              // Stripe’s event.id
  type       String
  receivedAt DateTime @default(now())
  payload    Json

  @@index([type])
}
