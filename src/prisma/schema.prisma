// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // For Vercel
  directUrl = env("POSTGRES_URL_NON_POOLING") // For migrations
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  hashedPassword String?   // For credential-based login
  // Add fields for OAuth provider IDs if you implement social logins
  // e.g., googleId String? @unique

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stripeCustomerId String?   @unique // Important for Stripe integration
  tempNotes        String? 
  roseWasHere String?
  subscriptions Subscription[]
  // Any other fields your app needs for a user
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])

  stripeSubscriptionId String    @unique // From Stripe
  stripePriceId        String    // The ID of the Stripe Price object
  status               String    // e.g., "active", "trialing", "past_due", "canceled"
  currentPeriodStart   DateTime  // When the current period started
  currentPeriodEnd     DateTime  // When the current period ends / renews
  cancelAtPeriodEnd    Boolean   @default(false) // If Stripe is set to cancel at period end
  canceledAt           DateTime? // When it was actually canceled
  trialStart           DateTime?
  trialEnd             DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}